{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beglin://contracts/model/model-source-v1",
  "title": "Beglin Model Source Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model_id",
    "model_revision",
    "source_format",
    "files",
    "checkpoint_identity_sha256",
    "weight_checkpoint_identity_sha256",
    "immutable"
  ],
  "properties": {
    "schema": {
      "const": "beglin-model-source-v1"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_revision": {
      "type": "string",
      "minLength": 1
    },
    "source_format": {
      "enum": [
        "GGUF",
        "SAFETENSORS_SINGLE",
        "SAFETENSORS_SHARDED",
        "LEGACY_BEG_LIN"
      ]
    },
    "root_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logical_path",
          "sha256",
          "size_bytes",
          "kind"
        ],
        "properties": {
          "logical_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "checkpoint_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "discovered_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "immutable": {
      "const": true
    },
    "weight_checkpoint_identity_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

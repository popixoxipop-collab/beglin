{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beglin://contracts/model/operator-graph-v1",
  "title": "Beglin Operator Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model_id",
    "operators",
    "unsupported_primitives",
    "graph_sha256"
  ],
  "properties": {
    "schema": {
      "const": "beglin-operator-graph-v1"
    },
    "model_id": {
      "type": "string"
    },
    "operators": {
      "type": "array"
    },
    "unsupported_primitives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "graph_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

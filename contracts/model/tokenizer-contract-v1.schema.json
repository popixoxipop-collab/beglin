{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beglin://contracts/model/tokenizer-contract-v1",
  "title": "Beglin Tokenizer Contract v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "tokenizer_id",
    "tokenizer_family",
    "status",
    "contract_sha256"
  ],
  "properties": {
    "schema": {
      "const": "beglin-tokenizer-contract-v1"
    },
    "tokenizer_id": {
      "type": "string"
    },
    "tokenizer_family": {
      "type": "string"
    },
    "status": {
      "enum": [
        "IN_ENGINE_VERIFIED",
        "EXTERNAL_VERIFIED",
        "IMPLEMENTED_UNVERIFIED",
        "UNSUPPORTED"
      ]
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

  "info": {
    "description": "Read-only contract-first dashboard API for Beglin quantization experiments.",
    "title": "beglin-experiment-dashboard",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/canary": {
      "get": {
        "operationId": "getCanary",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CanaryView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Canary",
        "tags": [
          "dashboard"
        ]
      }
    },
    "/api/v1/dashboard/summary": {
      "get": {
        "operationId": "getDashboardSummary",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardSummaryView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Dashboard Summary",
        "tags": [
          "dashboard"
        ]
      }
    },
    "/api/v1/dashboard/variables": {
      "get": {
        "operationId": "getDashboardVariables",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VariablesView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Dashboard Variables",
        "tags": [
          "dashboard"
        ]
      }
    },
    "/api/v1/evidence/{evidence_id}": {
      "get": {
        "operationId": "getEvidence",
        "parameters": [
          {
            "in": "path",
            "name": "evidence_id",
            "required": true,
            "schema": {
              "title": "Evidence Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Evidence",
        "tags": [
          "dashboard"
        ]
      }
    },
    "/api/v1/experiments": {
      "get": {
        "operationId": "listExperiments",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ExperimentCard"
                  },
                  "title": "Response Listexperiments",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Experiments",
        "tags": [
          "dashboard"
        ]
      }
    },
    "/api/v1/policy": {
      "get": {
        "operationId": "getPolicy",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Policy",
        "tags": [
          "dashboard"
        ]
      }
    },
    "/api/v1/production": {
      "get": {
        "operationId": "getProduction",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductionView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Production",
        "tags": [
          "dashboard"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthView"

{
  "$id":"https://beglin.local/schemas/heatmap/numeric-observation-v1.schema.json",
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"numeric-observation-v1","type":"object","additionalProperties":false,
  "properties":{
    "schema":{"const":"beglin-numeric-observation-v1"},
    "identity":{"$ref":"observation-identity-v2.schema.json"},
    "weight_abs":{"type":"number","minimum":0},
    "weight_rms":{"type":"number","minimum":0},
    "weight_max_abs":{"type":"number","minimum":0},
    "activation_mean_abs":{"type":"number","minimum":0},
    "activation_rms":{"type":"number","minimum":0},
    "activation_max_abs":{"type":"number","minimum":0},
    "output_mean_abs":{"type":"number","minimum":0},
    "output_rms":{"type":"number","minimum":0},
    "finite":{"type":"boolean"},
    "saturation_count":{"type":"integer","minimum":0},
    "clipping_count":{"type":"integer","minimum":0},
    "dynamic_range_log2":{"type":"number"},

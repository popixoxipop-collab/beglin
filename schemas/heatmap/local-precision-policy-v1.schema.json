{
  "$id":"https://beglin.local/schemas/heatmap/local-precision-policy-v1.schema.json",
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"local-precision-policy-v1","type":"object","additionalProperties":false,
  "properties":{
    "schema":{"const":"beglin-local-precision-policy-v1"},
    "policy_id":{"type":"string","minLength":1},
    "checkpoint_identity_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "skeleton_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "heatmap_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "weight_epoch":{"type":"integer","minimum":0},
    "generation":{"type":"integer","minimum":0},
    "default_precision":{"type":"string","minLength":1},
    "approved_by_beval":{"type":"boolean"},
    "cells":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{
      "target_key":{"type":"string","minLength":1},
      "qgroup_index":{"type":"integer","minimum":0},
      "group_size":{"type":"integer","minimum":1},
      "n":{"type":"integer","minimum":1},
      "confidence":{"type":"number","minimum":0,"maximum":1}
    },"required":["target_key","qgroup_index","group_size","n","confidence"]}}
  },
  "required":["schema","policy_id","checkpoint_identity_sha256","skeleton_sha256","heatmap_sha256","weight_epoch","generation","default_precision","approved_by_beval","cells"]
}
{
  "$id":"https://beglin.local/schemas/heatmap/selective-training-policy-v1.schema.json",
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"selective-training-policy-v1","type":"object","additionalProperties":false,
  "properties":{
    "schema":{"const":"beglin-selective-training-policy-v1"},
    "policy_id":{"type":"string","minLength":1},
    "checkpoint_identity_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "skeleton_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "heatmap_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "weight_epoch":{"type":"integer","minimum":0},
    "generation":{"type":"integer","minimum":0},
    "approved_by_beval":{"type":"boolean"},
    "cells":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{
      "target_key":{"type":"string","minLength":1},
      "trainable":{"type":"boolean"},
      "lr_scale":{"type":"number","minimum":0},
      "weight_decay_scale":{"type":"number","minimum":0},
      "master_precision":{"enum":["BF16","FP16","FP32"]},
      "confidence":{"type":"number","minimum":0,"maximum":1}
    },"required":["target_key","trainable","lr_scale","weight_decay_scale","master_precision","confidence"]}}
  },
  "required":["schema","policy_id","checkpoint_identity_sha256","skeleton_sha256","heatmap_sha256","weight_epoch","generation","approved_by_beval","cells"]
}
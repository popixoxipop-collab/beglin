{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_id",
    "checkpoint_identity_sha256",
    "heatmap_sha256",
    "weight_epoch",
    "generation",
    "approved_by_beval",
    "cells"
  ],
  "properties": {
    "schema": {
      "const": "beglin-local-precision-policy-v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "heatmap_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "weight_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "approved_by_beval": {
      "type": "boolean"
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_key",
          "qgroup_index",
          "n"
        ],
        "properties": {
          "target_key": {
            "type": "string"
          },
          "qgroup_index": {
            "type": "integer",
            "minimum": 0
          },
          "n": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}

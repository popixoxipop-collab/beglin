{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_heatmap_sha256",
    "error_budget",
    "cells"
  ],
  "properties": {
    "schema": {
      "const": "beglin-q-uncertainty-v1"
    },
    "source_heatmap_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "error_budget": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_key",
          "classification",
          "recommended_n",
          "safe_probability",
          "epistemic_uncertainty",
          "aleatoric_proxy",
          "boundary_score",
          "active_observation_priority"
        ],
        "properties": {
          "target_key": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "SAFE",
              "BOUNDARY",
              "NON_MONOTONIC",
              "UNSATISFIED"
            ]
          },
          "recommended_n": {
            "type": "integer",
            "minimum": 1
          },
          "safe_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "epistemic_uncertainty": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "aleatoric_proxy": {
            "type": "number",
            "minimum": 0
          },
          "boundary_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "active_observation_priority": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}

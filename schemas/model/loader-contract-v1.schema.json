{
  "$id": "https://beglin.local/schemas/model/loader-contract-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "loader_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "beglin-loader-contract-v1"
    },
    "silent_dense_fallback_allowed": {
      "const": false
    },
    "status": {
      "enum": [
        "VERIFIED",
        "IMPLEMENTED_UNVERIFIED",
        "PARTIAL",
        "UNSUPPORTED"
      ]
    },
    "unsupported_formats": {
      "type": "array"
    },
    "memory_preflight": {
      "type": "object",
      "required": [
        "schema",
        "source_weight_bytes",
        "weight_file_count",
        "tensor_element_count",
        "dense_f16_equivalent_bytes",
        "load_strategy",
        "mmap_eligible",
        "runtime_resident_estimate_status",
        "requires_runtime_measurement"
      ],
      "properties": {
        "schema": {
          "const": "beglin-loader-memory-preflight-v1"
        },
        "source_weight_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "weight_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "tensor_element_count": {
          "type": "integer",
          "minimum": 0
        },
        "dense_f16_equivalent_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "load_strategy": {
          "enum": [
            "MMAP_PAGECACHE",
            "SHARD_AWARE",
            "LEGACY"
          ]
        },
        "mmap_eligible": {
          "type": "boolean"
        },
        "runtime_resident_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "runtime_resident_estimate_status": {
          "const": "REQUIRES_BACKEND_PROFILE"
        },
        "requires_runtime_measurement": {
          "const": true
        }
      }
    }
  },
  "required": [
    "schema",
    "architecture_id",
    "source_format",
    "status",
    "loader_contract_sha256"
  ],
  "title": "loader-contract-v1",
  "type": "object"
}

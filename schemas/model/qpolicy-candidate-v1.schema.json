{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_id",
    "source_heatmap_sha256",
    "tensor_name",
    "tensor_sha256",
    "generation",
    "current_n",
    "cells",
    "distribution",
    "approved_by_beval",
    "production_write_allowed",
    "automatic_live_promotion",
    "candidate_sha256"
  ],
  "properties": {
    "schema": {
      "const": "beglin-qpolicy-candidate-v1"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^qpc_[a-f0-9]{16}$"
    },
    "source_heatmap_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tensor_name": {
      "type": "string",
      "minLength": 1
    },
    "tensor_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "current_n": {
      "type": "integer",
      "minimum": 1
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_key",
          "qgroup_index",
          "before_n",
          "proposed_n",
          "expected_error",
          "confidence"
        ],
        "properties": {
          "target_key": {
            "type": "string",
            "minLength": 1
          },
          "qgroup_index": {
            "type": "integer",
            "minimum": 0
          },
          "before_n": {
            "type": "integer",
            "minimum": 1
          },
          "proposed_n": {
            "type": "integer",
            "minimum": 1
          },
          "expected_error": {
            "type": "number",
            "minimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "approved_by_beval": {
      "const": false
    },
    "production_write_allowed": {
      "const": false
    },
    "automatic_live_promotion": {
      "const": false
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

{
  "$id": "https://beglin.local/schemas/model/tokenizer-contract-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "schema": {
      "const": "beglin-tokenizer-contract-v1"
    },
    "silent_fallback_allowed": {
      "const": false
    },
    "status": {
      "enum": [
        "IN_ENGINE_VERIFIED",
        "EXTERNAL_VERIFIED",
        "IMPLEMENTED_UNVERIFIED",
        "UNSUPPORTED"
      ]
    },
    "text_io_supported": {
      "type": "boolean"
    },
    "tokenizer_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "SENTENCEPIECE",
        "BPE_FILES",
        "GGUF_EMBEDDED_OR_EXTERNAL",
        "NONE"
      ]
    },
    "adapter_candidate": {
      "type": [
        "string",
        "null"
      ]
    },
    "encode_backend": {
      "type": [
        "string",
        "null"
      ]
    },
    "decode_backend": {
      "type": [
        "string",
        "null"
      ]
    },
    "text_io_mode": {
      "enum": [
        "DENSE_GGUF_GREEDY",
        "NOT_WIRED"
      ]
    }
  },
  "required": [
    "schema",
    "architecture_id",
    "tokenizer_family",
    "status",
    "tokenizer_contract_sha256"
  ],
  "title": "tokenizer-contract-v1",
  "type": "object"
}

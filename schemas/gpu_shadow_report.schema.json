{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beglin.local/schemas/gpu-shadow-report-v1.json",
  "title": "Beglin GPU Shadow Observability Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "observed_at",
    "production_write_allowed",
    "source_freshness",
    "evidence_level",
    "launcher",
    "cycle",
    "identity",
    "gpu_validation",
    "artifacts",
    "warnings",
    "unknown_fields",
    "report_sha256"
  ],
  "properties": {
    "schema": {"const": "gpu-shadow-report-v1"},
    "observed_at": {"type": "string"},
    "production_write_allowed": {"const": false},
    "source_freshness": {
      "enum": ["current", "stale_previous_cycle", "legacy_unlinked", "unknown"]
    },
    "evidence_level": {
      "enum": ["real_gpu", "not_run", "legacy_unverified", "shadow_terminal", "unknown"]
    },
    "launcher": {
      "type": "object",
      "required": ["state", "launch_id", "pid_alive", "returncode"],
      "properties": {
        "state": {"type": "string"},
        "launch_id": {"type": ["string", "null"]},
        "pid": {"type": ["integer", "string", "null"]},
        "pid_alive": {"type": ["boolean", "null"]},
        "returncode": {"type": ["integer", "null"]},
        "started_at": {"type": ["string", "null"]},
        "finished_at": {"type": ["string", "null"]},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": true
    },
    "cycle": {
      "type": "object",
      "required": [
        "relation_to_launcher",
        "status",
        "pipeline_state",
        "cycle_id",
        "shadow_run_id",
        "ready_count",
        "dedupe_reason"
      ],
      "properties": {
        "relation_to_launcher": {
          "enum": ["current", "previous", "legacy_unlinked", "unknown"]
        },
        "status": {"type": ["string", "null"]},
        "pipeline_state": {"enum": ["not_run", "executed", "failed", "unknown"]},
        "launch_id": {"type": ["string", "null"]},
        "cycle_id": {"type": ["string", "null"]},
        "shadow_run_id": {"type": ["string", "null"]},
        "started_at": {"type": ["string", "null"]},
        "finished_at": {"type": ["string", "null"]},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0},
        "candidate_count": {"type": ["integer", "null"], "minimum": 0},
        "ready_count": {"type": ["integer", "null"], "minimum": 0},
        "selected_candidate": {"type": ["string", "null"]},
        "deferred_candidate_ids": {"type": "array", "items": {"type": ["string", "null"]}},
        "dedupe_reason": {"type": ["string", "null"]},
        "manual_review_candidate_ids": {"type": "array", "items": {"type": "string"}},
        "retrying_candidate_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "identity": {
      "type": "object",
      "required": [
        "validation_context_fingerprint",
        "binary_sha256",
        "checkpoint_sha256",
        "candidate_fingerprints"
      ],
      "properties": {
        "validation_context_fingerprint": {"type": ["string", "null"]},
        "binary_sha256": {"type": ["string", "null"]},
        "checkpoint_sha256": {"type": ["string", "null"]},
        "checkpoint_manifest_ref": {"type": ["string", "null"]},
        "candidate_fingerprints": {"type": "object"}
      },
      "additionalProperties": true
    },
    "gpu_validation": {
      "type": "object",
      "required": ["state", "shadow_status", "final_status", "g4_status", "g6_status", "rollback_status"],
      "properties": {
        "state": {"enum": ["passed", "failed", "not_run", "unknown"]},
        "shadow_status": {"type": ["string", "null"]},
        "final_status": {"type": ["string", "null"]},
        "g4_status": {"type": ["string", "null"]},
        "g6_status": {"type": ["string", "null"]},
        "rollback_status": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "unknown_fields": {"type": "array", "items": {"type": "string"}},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
